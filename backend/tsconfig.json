{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "*": ["./*"]
    }
  },
  "include": ["*.ts", "config/**/*.ts", "controllers/**/*.ts", "routes/**/*.ts", "service/**/*.ts", "utils/**/*.ts", "types/**/*.ts"],
  "exclude": ["node_modules", "dist", "public"]
}
